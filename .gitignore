# Visual Studio 缓存
.vs/

# .NET / UWP 构建产物
bin/
obj/

# PRI 工具 dump 目录
.pridump/

# MSIX / AppX 打包产物
AppPackages/
BundleArtifacts/

# dotnet pack 的输出目录（publish.yml 用 -o artifacts，只在 CI 里当 artifact 上传）
# 注意 *.nupkg 那条匹配不到 .snupkg，符号包会漏网，所以整个目录排掉
artifacts/

# 用户级 / IDE 配置文件
*.user
*.suo
*.userosscache

# C++/WinRT 生成的投影头文件
Reactor.Uwp.Native/generated/

# C++/WinRT 编译产物
Reactor.Uwp.Native/*.obj
Reactor.Uwp.Native/*.exp
Reactor.Uwp.Native/*.lib
Reactor.Uwp.Native/*.dll
Reactor.Uwp.Native/*.pdb

# 临时文件和诊断数据
# 注意：这里用 .workbuddy/* 而不是 .workbuddy/ —— 父目录一旦被整体排除，
# 子目录就没法再"反忽略"回来。skills/ 是要给后人（AI）看的排查笔记，必须入库。
.workbuddy/*
!.workbuddy/skills/
dumps/
*.dmp

# Windows SDK / WinUI 元数据参考：由本地 SDK 提供，cppwinrt 需要它但不必入库
# （96 个文件约 7.8M，且随 SDK 版本变化，提交只会导致仓库膨胀与版本错配）
Reactor.Uwp.Native/winmd/

# cppwinrt 工具包本身同样不入仓库
*.nupkg

# 预编译产物（可选：如果想在 CI 重新生成）
# Reactor.Uwp.Native/prebuilt/
#
# 注：prebuilt/ 下的 Reactor.Uwp.Native.dll 是**要入库**的——CI 不做交叉编译，
# 直接把它打进 runtimes\win-{x64,arm64}\native\。但链接器顺带产出的
# exp / lib / pdb 对消费方没用，只占空间，这里排掉。
Reactor.Uwp.Native/prebuilt/**/*.exp
Reactor.Uwp.Native/prebuilt/**/*.lib
Reactor.Uwp.Native/prebuilt/**/*.pdb