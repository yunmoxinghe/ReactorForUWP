<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- 19041：官方 UWP + 现代 .NET 模板用的下限，与 Reactor.Template 保持一致。 -->
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>

    <!-- UseUwpTools：官方 UWP + 现代 .NET 模板必设属性之一。它告诉各 MSBuild
         组件"这是 UWP 应用"：导入 XAML 编译器、声明项目能力。缺了它 MSIX 那一步
         不参与，VS 也不把项目当可部署的 UWP 应用（F5 退化成跑裸 exe，没有包身份）。 -->
    <UseUwpTools>true</UseUwpTools>

    <!-- 与 Reactor.Template / UWP-Blank-Template 一致：x64 + arm64。
         arm64 需要 Reactor.Uwp >= alpha.4（包里才有 win-arm64 的原生桥）。 -->
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>

    <!-- AOT：UWP + net10 的 AOT 走的是平台自带的编译链，不需要额外装什么东西；
         开它才能暴露"用了反射 / 运行时代码生成"的写法（示例里没用，是干净的）。
         DisableRuntimeMarshalling 与框架工程保持一致：WinRT 互操作由
         CsWinRT 生成的封送代码负责，运行时封送开着只会拖慢调用。 -->
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- 打包属性，与 Reactor.Template / UWP-Blank-Template 对齐。
         GenerateTemporaryStoreCertificate 让 VS 按 manifest 的 Publisher 主题自动生成并
         信任测试证书；没有它，本机无匹配证书时部署会退化成跑裸 exe（无包身份 → 0xc0000409）。 -->
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>

    <AppxBundle>Never</AppxBundle>
    <AppxBundlePlatforms>x64|arm64</AppxBundlePlatforms>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与 Reactor.Template 不同：这里<b>引用仓库里的框架源码</b>，不装 NuGet 包。
         分工是这样定的：
         · Reactor.Template = 新项目的起点，走 PackageReference，编译通过即证明
           "包里的公共 API 够用"（源码引用会掩盖导出问题）；
         · Reactor.Gallery  = 框架自身的验证载体，里面那个「受控控件诊断」页要读
           ReactorLog / 闸门计数这类<b>尚未发版</b>的观测 API，只能走工程引用。
         发布 alpha 包之前，用它跑一遍受控控件，是最快的一次性定性手段。 -->
    <ProjectReference Include="..\..\Reactor.uwp\Reactor.uwp.csproj" />
    <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
  </ItemGroup>

  <!-- 原生桥 DLL：走<b>工程引用</b>的项目必须自己声明一次，否则它不会进 AppX。
       库项目没有 RuntimeIdentifier，Content 输出落在 bin\x64\Debug\<tfm>\ 下，
       而本 App 带 RID、实际运行目录是 bin\x64\Debug\<tfm>\win-x64\AppX\ ——
       跨项目引用的 Content 不会跟着进 RID 子目录，于是
       LibraryImport("Reactor.Uwp.Native.dll") 在运行时抛 DllNotFoundException，
       虚拟化那条路静默退化成自绘回退。
       UwpApp.csproj 里有同一段（那段注释更细）；Reactor.Template 不用写是因为
       它走 NuGet 包，包里的 runtimes\win-$(Platform)\native\ + build targets 会送过去。
       少了它最典型的症状是"虚拟化示例看起来也能跑，但 realized 容器数不对"——
       不报错，只是那条路根本没走原生产物。 -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\Reactor.Uwp.Native\prebuilt\$(Platform)\Reactor.Uwp.Native.dll')">
    <Content Include="$(MSBuildThisFileDirectory)..\..\Reactor.Uwp.Native\prebuilt\$(Platform)\Reactor.Uwp.Native.dll">
      <Link>Reactor.Uwp.Native.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 示例源码<b>本身</b>也是画廊的一份展品：SampleCodePresenter 展示的那段代码，
         读的就是这里嵌进包里的文件，而不是在别处另抄一份字符串。
         这样"看到的代码"与"跑起来的代码"同源 —— 复制出去能编译，
         改了这个文件码块跟着变，不会出现"注释里的样板是对的、跑的却是另一份"
         那种腐化（手写样板最常见的归宿）。WinUI 3 Gallery 的 SampleCodePresenter
         也是从源文件加载的，这一点特意保持一致。

         这里<b>没有</b>排除默认的 Compile：同一个文件既是编译单元又是嵌入资源，
         两边各取所需。 -->
    <EmbeddedResource Include="Gallery\Samples\**\*.cs" />
    <EmbeddedResource Include="Pages\**\*.cs" />
  </ItemGroup>
</Project>
