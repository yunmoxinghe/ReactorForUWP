<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- 19041：官方 UWP + 现代 .NET 模板用的下限，与 Reactor.Template 保持一致。 -->
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>

    <!-- UseUwpTools：官方 UWP + 现代 .NET 模板必设属性之一。它告诉各 MSBuild
         组件"这是 UWP 应用"：导入 XAML 编译器、声明项目能力。缺了它 MSIX 那一步
         不参与，VS 也不把项目当可部署的 UWP 应用（F5 退化成跑裸 exe，没有包身份）。 -->
    <UseUwpTools>true</UseUwpTools>

    <!-- 与 Reactor.Template / UWP-Blank-Template 一致：x64 + arm64。
         arm64 需要 Reactor.Uwp >= alpha.4（包里才有 win-arm64 的原生桥）。 -->
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>

    <!-- AOT：UWP + net10 的 AOT 走的是平台自带的编译链，不需要额外装什么东西；
         开它才能暴露"用了反射 / 运行时代码生成"的写法（示例里没用，是干净的）。
         DisableRuntimeMarshalling 与框架工程保持一致：WinRT 互操作由
         CsWinRT 生成的封送代码负责，运行时封送开着只会拖慢调用。 -->
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- 打包属性，与 Reactor.Template / UWP-Blank-Template 对齐。
         GenerateTemporaryStoreCertificate 让 VS 按 manifest 的 Publisher 主题自动生成并
         信任测试证书；没有它，本机无匹配证书时部署会退化成跑裸 exe（无包身份 → 0xc0000409）。 -->
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>

    <AppxBundle>Never</AppxBundle>
    <AppxBundlePlatforms>x64|arm64</AppxBundlePlatforms>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 示例的关键点：装 NuGet 包，不引用仓库里的框架源码。
         这样示例编译通过 = 包里的公共 API 真够用（源码引用会掩盖导出问题）。
         升级用法：改这里的 Version。 -->
    <PackageReference Include="Reactor.Uwp" Version="0.1.0-alpha.4" />
    <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
  </ItemGroup>
</Project>
