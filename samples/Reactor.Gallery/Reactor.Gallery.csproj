<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>

    <!-- UseUwpTools：官方 UWP + 现代 .NET 模板必设属性之一。它告诉各 MSBuild
         组件"这是 UWP 应用"：导入 XAML 编译器、声明项目能力。缺了它 MSIX 那一步
         不参与，VS 也不把项目当可部署的 UWP 应用（F5 退化成跑裸 exe，没有包身份）。 -->
    <UseUwpTools>true</UseUwpTools>

    <!-- 只留 x64：Reactor.Uwp 的原生桥（给 ItemsRepeater 补的 IElementFactory）
         目前只有 win-x64 预编译产物，其它架构下自定义工厂不可用。
         示例不打算演示"半可用"状态，所以不列 x86/arm64。 -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <DefaultLanguage>zh-CN</DefaultLanguage>

    <!-- AOT：UWP + net10 的 AOT 走的是平台自带的编译链，不需要额外装什么东西；
         开它才能暴露"用了反射 / 运行时代码生成"的写法（示例里没用，是干净的）。
         DisableRuntimeMarshalling 与框架工程保持一致：WinRT 互操作由
         CsWinRT 生成的封送代码负责，运行时封送开着只会拖慢调用。 -->
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- 示例的关键点：装 NuGet 包，不引用仓库里的框架源码。
         这样示例编译通过 = 包里的公共 API 真够用（源码引用会掩盖导出问题）。
         升级用法：改这里的 Version。 -->
    <PackageReference Include="Reactor.Uwp" Version="0.1.0-alpha.3" />
  </ItemGroup>
</Project>
