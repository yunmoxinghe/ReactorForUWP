<?xml version="1.0" encoding="utf-8"?>
<root>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <!-- manifest 里用 ms-resource:AppDisplayName / ms-resource:AppDescription 引用这两条。
       加新语言就复制一份 Strings\<locale>\Resources.resw，并在 manifest 的
       <Resources> 里补对应语言（或用 x-generate 让打包时自动收）。 -->
  <data name="AppDisplayName" xml:space="preserve">
    <value>Reactor Template</value>
  </data>
  <data name="AppDescription" xml:space="preserve">
    <value>A Reactor.Uwp starting point</value>
  </data>
  <!-- Keys for x:Uid. Mirrors Strings\zh-CN\Resources.resw one-to-one.
       标识符逐条照抄参考实现 UWP-Blank-Template 的
       UWPTemplate.Package\Strings\<locale>\Resources.resw：
       HomePageWelcomeText / AppearanceGroup / SoundGroup / AboutGroup。
       不要重命名 —— 资源标识符一变就等于删旧条目 + 加新条目，翻译要重来。 -->
  <data name="HomePageWelcomeText.Text" xml:space="preserve">
    <value>Welcome to the home page, a UWP template app</value>
  </data>
  <data name="AppearanceGroup.Text" xml:space="preserve">
    <value>Appearance</value>
  </data>
  <data name="SoundGroup.Text" xml:space="preserve">
    <value>Sound</value>
  </data>
  <data name="AboutGroup.Text" xml:space="preserve">
    <value>About</value>
  </data>
</root>
