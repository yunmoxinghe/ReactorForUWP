<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  IgnorableNamespaces="uap uap5 mp">

  <!-- 新项目必改两处：Name 换成自己的 GUID，Publisher 换成自己的证书主题
       （VS 首次部署会生成测试证书，主题要与这里一致）。 -->
  <Identity
    Name="21CE1A0C-1D93-4A28-AE85-B632189C9236"
    Publisher="CN=yunmoxing"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="21CE1A0C-1D93-4A28-AE85-B632189C9236" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <!-- 包名（Properties/DisplayName）写字面量，不走 ms-resource。
       原因：Package.Current.DisplayName 读的就是这一项，而它走的是 AppModel
       的实时 ms-resource 解析 —— 实测在本包上会解析到错误的资源
       （拿到的是 SoundGroup/Text 的值「声音」），而按名字查资源表
       （ResourceLoader.GetString("AppDisplayName")）始终正确。
       这是 AppModel 层的行为，代码改不动，所以这一项直接用字面量兜死。
       开始菜单/磁贴走的是下面 uap:VisualElements/@DisplayName，那条实测解析
       正确，仍然保留 ms-resource（外壳名字照旧本地化）。 -->
  <Properties>
    <DisplayName>Reactor 模板</DisplayName>
    <PublisherDisplayName>yunmoxing</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 与 csproj 的 TargetPlatformMinVersion / TargetPlatformVersion 对齐。 -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- 用 x-generate 的话，打包时只按 DefaultLanguage 收一份；这里显式列出，
       Strings 下每种语言的 resw 都会进包。 -->
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-CN" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="Reactor.Template.App">
      <uap:VisualElements
        DisplayName="ms-resource:AppDisplayName"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="ms-resource:AppDescription"
        BackgroundColor="transparent">
        <!-- 与 UWP-Blank-Template 一致：三块磁贴尺寸都给全（中 / 宽 / 大）。
             参考的 SmallTile / LargeTile，Assets 里是 SmallTile.scale-*.png 和
             LargeTile.scale-*.png，引用时不带限定符，由 resources.pri 按 DPI 挑。 -->
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\SmallTile.png"
          Square310x310Logo="Assets\LargeTile.png"/>
        <!-- uap5:Optional="true"：Assets 里只有 SplashScreen.scale-*.png，没有不带
             限定符的那一份。正常部署靠 resources.pri 解析限定符，而松散注册（没有 pri）
             时会报 0x80070002 找不到初始屏幕图像。标成 Optional 就不再是硬要求。 -->
        <uap:SplashScreen Image="Assets\SplashScreen.png" uap5:Optional="true" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- 模板默认给网络权限；用不到就删掉这一行。 -->
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
