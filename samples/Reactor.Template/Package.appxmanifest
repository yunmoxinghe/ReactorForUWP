<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!-- 新项目必改两处：Name 换成自己的 GUID，Publisher 换成自己的证书主题
       （VS 首次部署会生成测试证书，主题要与这里一致）。 -->
  <Identity
    Name="21CE1A0C-1D93-4A28-AE85-B632189C9236"
    Publisher="CN=yunmoxing"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="21CE1A0C-1D93-4A28-AE85-B632189C9236" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Reactor Template</DisplayName>
    <PublisherDisplayName>yunmoxing</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 与 csproj 的 TargetPlatformMinVersion / TargetPlatformVersion 对齐。 -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="Reactor.Template.App">
      <uap:VisualElements
        DisplayName="Reactor Template"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Reactor.Uwp 项目模板"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
