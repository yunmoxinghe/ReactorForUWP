<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>

    <!-- 只留 x64：Reactor.Uwp 的原生桥（给 ItemsRepeater 补的 IElementFactory）
         目前只有 win-x64 预编译产物。等其它架构补上再放开 Platforms。 -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <DefaultLanguage>zh-CN</DefaultLanguage>

    <!-- AOT 默认开着：UWP + net10 的 AOT 用的是平台自带编译链，不额外依赖什么，
         而且它能第一时间暴露"反射 / 运行时代码生成"这类在 AOT 下会炸的写法。
         真需要反射时加 rd.xml 或 [DynamicallyAccessedMembers]，别直接关掉它。 -->
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- 新项目的起点：装包，然后把 App.cs / MainPage.cs 改成自己的。 -->
    <PackageReference Include="Reactor.Uwp" Version="0.1.0-alpha.2" />
  </ItemGroup>
</Project>
