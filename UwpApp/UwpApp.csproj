<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- 19041 而不是 17763：与两个示例及 UWP-Blank-Template 一致，
         官方 UWP + 现代 .NET 模板用的就是这个下限。改了这里，
         Package.appxmanifest 的 TargetDeviceFamily MinVersion 要跟着改。 -->
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>
    <!-- 只支持 x64 与 arm64：原生桥 Reactor.Uwp.Native.dll 只有这两个架构的
         预编译产物，项目不做 x86。 -->
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reactor.uwp\Reactor.uwp.csproj" />
  </ItemGroup>

  <!-- 原生桥 DLL：必须显式在主项目里声明一次。
       库项目（Reactor.uwp）没有 RuntimeIdentifier，它的 Content 输出落在
       bin\x64\Debug\<tfm>\ 下；而本 App 带 RID，实际运行目录是
       bin\x64\Debug\<tfm>\win-x64\AppX\ —— 两者不是一个目录，
       跨项目引用的 Content 不会自动跟着进 RID 子目录，
       结果就是 LibraryImport("Reactor.Uwp.Native.dll") 在运行时抛 DllNotFoundException。
       这里按平台直接指向预编译产物，缺该架构时静默跳过，不阻塞其它架构构建。 -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\Reactor.Uwp.Native\prebuilt\$(Platform)\Reactor.Uwp.Native.dll')">
    <Content Include="$(MSBuildThisFileDirectory)..\Reactor.Uwp.Native\prebuilt\$(Platform)\Reactor.Uwp.Native.dll">
      <Link>Reactor.Uwp.Native.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>