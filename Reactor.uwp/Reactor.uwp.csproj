<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- 19041：与两个示例 / UwpApp / UWP-Blank-Template 一致。库声明的下限会传给
         消费方，写 17763 等于宣称支持一个没人验过的下限。 -->
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <IsAotCompatible>true</IsAotCompatible>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <!-- LibraryImport 生成的封送存根内部用到了 unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 临时探针需要访问 Internal 层的封装，待 NativeElementFactory 接入正式 Element 后移除 -->
  <ItemGroup>
    <InternalsVisibleTo Include="UwpApp" />
  </ItemGroup>

  <!-- 注意：这里<b>不</b>再包含原生桥 DLL 的 Content 项。
       包里的那份走下面的 runtimes\ + build\targets；仓库内构建由 UwpApp 自己
       显式声明（见 UwpApp.csproj 注释：库项目没有 RID，Content 传不到
       消费方的 win-x64\AppX\ 目录）。同一个文件同时给 Content 与 None/Pack
       两个项时 NuGet 会按文件去重，Pack=false 会连带把 runtimes 那份也吞掉。 -->

  <!-- ── NuGet 打包 ──────────────────────────────────────────────
       用 PackageVersion 而不是 Version：前者只作用于包元数据，不动程序集版本号。
       授权：MIT，与仓库根目录的 LICENSE 一致（nuget.org 上 Reactor.Uwp 这个 id 未被占用）。 -->
  <PropertyGroup>
    <PackageId>Reactor.Uwp</PackageId>
    <!-- alpha.4 起包里带 runtimes\win-arm64\native\Reactor.Uwp.Native.dll
         （与 win-x64 并列），示例的 Platforms 因此能写 x64;arm64。 -->
    <!-- alpha.5：重渲染批处理补上死循环保护（连续 50 轮自触发即抛），
         本地化切语言链路修好，RenderBatcher / Reorder 有回归测试兜底。
         注意 alpha.5 起 setState 语义与官方对齐（不再同步生效）。 -->
    <!-- alpha.6：修掉受控控件的一批 bug，全是"点了没反应"的不同面孔
         （机制、源码行号与反向对照见 docs/release-notes/alpha.6.md）：
         · 吞掉"取消选中"后没把控件纠正回来 → 点当前已选中项、或选中项被虚拟化
           回收之后，控件停在"无选中"而 state 仍有值；
         · 受控写入在"不会抛事件"的时刻泄漏回声登记 → 之后点回同一个值被当成
           回声吞掉（这就是"换个值就正常，点这个值没反应"的来源）；
         · 回调为空时的受控写入同样泄漏 —— 三个 handler 共有，不是某一个的病；
         · 受控纠正被绑到"有没有人监听"上 → 没挂回调的页面永久停在"没选中"；
         · ListView / GridView（ItemsViewHandler）此前一份受控设施都没接：受控
           写回被当成用户输入回调出去、换数据源时凭空回调、items 变少后越界
           写入被内核整条 undo。三处策略统一到 SelectionPolicy.ShouldApply。
         · x:Uid 那笔写落在订阅之后（Localization.ApplyUid 排在 Build 末尾）→
           挂载时凭空多一次 OnChanged，state 被 resw 里的串改写；
         · 改 Minimum / Maximum 会把受控值夹走，那一发 ValueChanged 抛在旧订阅
           还挂着的时候 → 被当成用户输入回调出去（Slider / NumberBox 共有）。
         另给受控值越界加了纠正守卫，防止越界时自激。
         以上都是测试自行发现并复现的，含"不修就坏"的反向对照。 -->
    <PackageVersion>0.1.0-alpha.8</PackageVersion>
    <Authors>云漠星</Authors>
    <Copyright>Copyright © 2026 云漠星</Copyright>
    <Description>UWP + WinUI 2 的声明式 UI 框架：用 C# 描述界面，不写 XAML。映射 WinUI 2 控件（不是内置控件树），带自实现的虚拟列表与 ItemsRepeater 原生工厂桥。</Description>
    <PackageTags>uwp;winui;winui2;reactor;declarative-ui;winrt;csharp;xaml-free</PackageTags>
    <!-- 有这两个 nuget.org 包页面才会显示仓库入口，否则页面上一片空白、找不回源码。 -->
    <PackageProjectUrl>https://github.com/yunmoxinghe/ReactorForUWP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yunmoxinghe/ReactorForUWP.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- NU5100：原生产物放在 runtimes\ 而不是 lib\，NuGet 一律警告"不能加为引用"，
         这正是我们要的（它不是托管引用），属误报。 -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- build\*.targets 会被 NuGet 自动导入消费方项目（build/ 约定，不用手写 props 导入）。 -->
    <None Include="build\Reactor.uwp.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <!-- 原生桥 DLL：按架构进 runtimes\，落盘由 build\Reactor.uwp.targets 负责。
       两个 ItemGroup 一模一样、只有架构不同：只打实际存在的架构——缺哪个架构，
       那个架构就没有自定义工厂（见 README 限制）。加新架构时照抄一段即可。 -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\Reactor.Uwp.Native\prebuilt\x64\Reactor.Uwp.Native.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\Reactor.Uwp.Native\prebuilt\x64\Reactor.Uwp.Native.dll"
          Pack="true"
          PackagePath="runtimes\win-x64\native\"
          Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\Reactor.Uwp.Native\prebuilt\arm64\Reactor.Uwp.Native.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\Reactor.Uwp.Native\prebuilt\arm64\Reactor.Uwp.Native.dll"
          Pack="true"
          PackagePath="runtimes\win-arm64\native\"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 2.8.7+ 才提供 net8.0-windows 投影程序集，可被 UseUwp 的 net10.0-windows TFM 选中；
         2.8.6 仅有 lib/uap10.0 老 winmd，NuGet 不会选为编译引用（CS0234）。 -->
    <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
    <!-- SettingsCard / SettingsExpander（WinUI 设置页的事实标准容器）。
         该包同时提供 net8/net9-windows10.0.26100 投影，与本项目 TFM 兼容。 -->
    <PackageReference Include="CommunityToolkit.Uwp.Controls.SettingsControls" Version="8.2.251219" />
    <!-- Microsoft.UI.Xaml → Microsoft.Web.WebView2 的**WPF** 资产
         （Microsoft.Web.WebView2.Wpf.dll）是纯传递依赖：UWP 侧的 WebView2 走
         Microsoft.UI.Xaml.winmd 与 Microsoft.Web.WebView2.Core.winmd，那两个 Wpf
         dll 根本用不到，却会与 .NET 的 WindowsBase 撞版本（warning MSB3277）。 -->
  </ItemGroup>

  <!-- 摘掉 WebView2 的 WPF 引用见仓库根 Directory.Build.targets：
       框架自身、走 ProjectReference 的 UwpApp、走 NuGet 包的示例，三条路都要干净，
       放一处就够（包消费方那份在 build\Reactor.uwp.targets）。 -->

</Project>
