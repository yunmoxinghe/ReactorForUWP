<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <IsAotCompatible>true</IsAotCompatible>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <!-- LibraryImport 生成的封送存根内部用到了 unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 临时探针需要访问 Internal 层的封装，待 NativeElementFactory 接入正式 Element 后移除 -->
  <ItemGroup>
    <InternalsVisibleTo Include="UwpApp" />
  </ItemGroup>

  <!-- ItemsRepeater 自定义工厂的原生桥（预编译产物，见 Reactor.Uwp.Native/build.bat）。
       Content + Link 会被 GetCopyToOutputDirectoryItems 沿项目引用传给消费方输出目录。
       缺某架构的预编译产物时静默跳过，不阻塞其它架构构建。 -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\Reactor.Uwp.Native\prebuilt\$(Platform)\Reactor.Uwp.Native.dll')">
    <Content Include="$(MSBuildThisFileDirectory)..\Reactor.Uwp.Native\prebuilt\$(Platform)\Reactor.Uwp.Native.dll"
             Link="Reactor.Uwp.Native.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 2.8.7+ 才提供 net8.0-windows 投影程序集，可被 UseUwp 的 net10.0-windows TFM 选中；
         2.8.6 仅有 lib/uap10.0 老 winmd，NuGet 不会选为编译引用（CS0234）。 -->
    <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
    <!-- SettingsCard / SettingsExpander（WinUI 设置页的事实标准容器）。
         该包同时提供 net8/net9-windows10.0.26100 投影，与本项目 TFM 兼容。 -->
    <PackageReference Include="CommunityToolkit.Uwp.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>
</Project>
